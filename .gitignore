# Environment
# Ignore every env file, then re-admit the documented template. `.env.prod`
# holds a real secret key and database/object-store passwords.
.env
.env.*
*.env.bak
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Django
backend/staticfiles/
backend/media/
backend/*.sqlite3

# Node
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# Local scratch (these live in docker volumes in normal use)
data/
*.part
SESSION.text