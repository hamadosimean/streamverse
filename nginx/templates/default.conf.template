# StreamVerse edge reverse proxy.
#
# What Nginx does NOT do here: serve video. Now that MinIO is the storage
# backend, HLS manifests and segments go browser -> MinIO:9010 directly. Putting
# Nginx in that path would add a hop for zero benefit. Its job is the API, the
# admin, WebSockets, the SPA, and (from Phase 4) RTMP ingest.

# Docker's embedded DNS. Required because the upstream containers' IPs change
# whenever they are recreated (`docker compose up -d backend`, a crash restart,
# a rebuild). A static `upstream {}` block resolves once at config load and then
# proxies to a dead address forever — this re-resolves every `valid=` window.
#
# The cost is losing upstream keepalive, which needs a static upstream block.
# For an API that is not in the hot path of media delivery, correct routing
# after a container restart is worth far more than saved TCP handshakes.
resolver 127.0.0.11 valid=10s ipv6=off;

# ---- Security posture --------------------------------------------------
# Do not advertise the exact nginx build; it tells a scanner which CVEs to try
# and helps nobody else.
server_tokens off;

# `$` variables below that look like ${NAME} are substituted by the image's
# envsubst step at container start (see NGINX_ENVSUBST_FILTER in the compose
# file, which restricts substitution to these names so nginx's own $variables
# survive untouched).
#
# The Content-Security-Policy is the single most valuable header here, because
# JWTs live in localStorage: without a CSP, one injected script reads them. With
# it, there is no origin an injected script may load code from or exfiltrate to.
#
#   worker-src blob:   hls.js spawns its demuxer worker from a Blob URL.
#   style-src unsafe-inline  React writes inline style="" attributes (progress
#                            bars, poster backgrounds), which CSP counts as
#                            inline styles. Nonces cannot cover attributes.
#   img/media/connect ${MINIO_PUBLIC_ENDPOINT}  posters, HLS manifests and
#                            segments are fetched straight from object storage.
#   connect-src 'self'  also authorises same-origin ws:// under CSP3, which is
#                       what the transcode-progress and live-chat sockets use.
map $host $sv_csp {
    default "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ${MINIO_PUBLIC_ENDPOINT}; media-src 'self' blob: ${MINIO_PUBLIC_ENDPOINT}; font-src 'self' data:; connect-src 'self' ${MINIO_PUBLIC_ENDPOINT}; manifest-src 'self'; frame-src 'none'";
}

# Every powerful browser feature the app does not use is denied. autoplay,
# fullscreen, PiP and EME are kept because they are the video player; camera,
# microphone and display-capture are kept because the live studio broadcasts
# from the browser. All of them are `self` — no embedded origin gets them.
map $host $sv_permissions {
    default "accelerometer=(), autoplay=(self), camera=(self), display-capture=(self), encrypted-media=(self), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(self), midi=(), payment=(), picture-in-picture=(self), usb=(), interest-cohort=()";
}

# Link-unfurling crawlers do not execute JavaScript, so the SPA shell tells them
# nothing. They are routed to a server-rendered preview instead. Google is
# deliberately NOT in this list: it renders JS, and serving it different HTML
# than a user gets is the definition of cloaking.
map $http_user_agent $sv_is_social_crawler {
    default 0;
    "~*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Slack-ImgProxy|Discordbot|TelegramBot|WhatsApp|SkypeUriPreview|redditbot|Pinterest|vkShare|embedly|Iframely|Applebot)" 1;
}

server {
    listen 80;
    server_name _;

    # tus PATCH bodies are 8 MiB chunks by default; leave headroom for a client
    # that negotiates larger ones.
    client_max_body_size 128m;
    client_body_timeout 300s;
    # Buffering an upload chunk to disk before forwarding it only adds latency.
    proxy_request_buffering off;

    proxy_http_version 1.1;
    # $http_host, not $host: $host strips the port, so Django's
    # request.build_absolute_uri() would emit http://localhost/... for a stack
    # published on :8110 — and the signed HLS manifest URLs handed to the player
    # would point at the wrong port.
    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $http_host;

    # ---- MediaMTX integration endpoints: internal only --------------------
    # These authorise RTMP publishing and drive the live-session lifecycle. They
    # are only meant to be called by MediaMTX from inside the compose network,
    # and the auth hook in particular cannot carry a shared secret. 404 them at
    # the edge so they are unreachable from the internet even though they live
    # under /api/.
    location ~ ^/api/live/(auth|authz|hooks)/ {
        return 404;
    }

    # ---- Live HLS (MediaMTX) ---------------------------------------------
    # Proxied rather than published on its own port: same-origin means no CORS
    # preflight per segment, and MediaMTX stays off the public port list.
    # Unlike VOD (which the browser fetches straight from MinIO), a live stream
    # has no object-storage URL to hand out — MediaMTX *is* the origin.
    # A named capture rather than `rewrite ... break`: with a variable in
    # proxy_pass, nginx forwards the ORIGINAL client URI, so a rewrite here is
    # silently ignored and MediaMTX receives the /live-hls prefix. Capturing the
    # remainder and interpolating it builds the upstream URI explicitly.
    # ---- Live HLS (MediaMTX) ---------------------------------------------
    # Proxied rather than published on its own port: same-origin means no CORS
    # preflight per segment, and MediaMTX stays off the public port list. Unlike
    # VOD (fetched straight from MinIO), a live stream has no object-storage URL
    # to hand out — MediaMTX *is* the origin.
    #
    # MediaMTX answers the first playlist request with a `?cookieCheck=1`
    # redirect (a browser-capability probe, not authorisation) whose Location is
    # relative to its own root. It is rewritten back into /live-hls/ with an
    # absolute URL including the port — $http_host, not $host, or a stack
    # published on :8110 sends the player to :80.
    #
    # Playlists are authorised via Django; segments are not. A player cannot keep
    # playing without refreshing the playlist every couple of seconds, so that is
    # where a takedown actually bites, while the bulk of the bytes never touch
    # Django's request path.
    location ~ ^/live-hls/(?<mtx_path>.*\.m3u8)$ {
        auth_request /_live_authz;

        set $mediamtx http://mediamtx:8888;
        proxy_pass $mediamtx/$mtx_path$is_args$args;

        proxy_set_header Host $http_host;
        proxy_redirect ~^/(.*)$ $scheme://$http_host/live-hls/$1;

        # A live playlist is rewritten every segment duration; caching one for
        # even a few seconds hands the player a stale window.
        proxy_cache off;
        proxy_buffering off;
        add_header Cache-Control "no-cache" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Content-Type-Options "nosniff" always;
        proxy_read_timeout 60s;
    }

    # Authorisation subrequest for the playlist location above.
    location = /_live_authz {
        internal;
        set $authz http://backend:8000;
        proxy_pass $authz/api/live/authz/?path=$mtx_path;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $http_host;
    }

    # Segments. No auth_request: they are the bulk of the traffic and the
    # playlist gate above already controls whether a player can reach them.
    location ~ ^/live-hls/(?<mtx_path>.*)$ {
        set $mediamtx http://mediamtx:8888;
        proxy_pass $mediamtx/$mtx_path$is_args$args;

        proxy_set_header Host $http_host;
        proxy_redirect ~^/(.*)$ $scheme://$http_host/live-hls/$1;
        proxy_buffering off;
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Content-Type-Options "nosniff" always;
        proxy_read_timeout 60s;
    }

    # ---- Live WebRTC ingest, WHIP (MediaMTX) -----------------------------
    # Signalling only: a short HTTP exchange that trades SDP and ICE candidates.
    # The media never comes through here — it is UDP straight from the browser
    # to MediaMTX's ICE port, which is why that one port is published while
    # :8889 is not.
    #
    # Proxied same-origin so the studio page needs no CORS preflight and no
    # second hostname, and so the WHIP endpoint inherits the app's own TLS
    # wherever the deployment terminates it.
    #
    # MediaMTX answers the initial POST with a `Location` pointing at the
    # session resource, relative to ITS root. The client PATCHes and DELETEs
    # that URL, so it is rewritten back under /live-webrtc/ — without this the
    # browser would try to DELETE /webrtc/<slug>/whip/<id> on the app origin and
    # a stopped broadcast would keep publishing.
    location ~ ^/live-webrtc/(?<whip_path>.*)$ {
        set $mediamtx_whip http://mediamtx:8889;
        proxy_pass $mediamtx_whip/$whip_path$is_args$args;

        proxy_set_header Host $http_host;
        proxy_redirect ~^/(.*)$ $scheme://$http_host/live-webrtc/$1;

        # An SDP offer is a few kilobytes and the answer is expected within the
        # handshake timeout; buffering it would only add latency to a request
        # the user is watching a spinner for.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 30s;

        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # ---- API -------------------------------------------------------------
    location /api/ {
        # `set` + a variable in proxy_pass is what forces per-request DNS
        # resolution; $request_uri carries the original path *and* query string,
        # which the variable form does not append automatically.
        set $backend http://backend:8000;
        proxy_pass $backend$request_uri;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # ---- Django admin (Jazzmin) -----------------------------------------
    location /admin/ {
        set $backend_admin http://backend:8000;
        proxy_pass $backend_admin$request_uri;
        proxy_read_timeout 120s;
    }

    # Any location that declares its own add_header stops inheriting the
    # server-level ones, so the security set is repeated in each of them.
    # `expires` is dropped here because it emits a second, conflicting
    # Cache-Control alongside the explicit one below.
    location /static/ {
        alias /var/www/static/;
        access_log off;
        add_header Cache-Control "public, max-age=2592000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
    }

    # ---- WebSockets (transcoding progress; live chat from Phase 4) -------
    location /ws/ {
        set $backend_ws http://backend:8000;
        proxy_pass $backend_ws$request_uri;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        # A transcode can run for many minutes with no traffic on the socket; do
        # not let the proxy time it out mid-encode.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # ---- SEO ------------------------------------------------------------
    # robots.txt and sitemap.xml are generated by Django, not shipped as static
    # files: the sitemap has to enumerate the live catalogue, and both need the
    # deployment's real origin rather than a value baked in at build time.
    location = /robots.txt {
        set $backend_seo http://backend:8000;
        proxy_pass $backend_seo/robots.txt;
    }

    location = /sitemap.xml {
        set $backend_seo http://backend:8000;
        proxy_pass $backend_seo/sitemap.xml;
    }

    # ---- Link previews for social crawlers -------------------------------
    # Same URL, two renderings: a person gets the SPA, a crawler that cannot run
    # JavaScript gets server-rendered Open Graph tags carrying the same title,
    # description and poster. `Vary: User-Agent` keeps any cache in between from
    # serving one to the other.
    location ~ "^/(?:watch|shorts)/(?<sv_video_id>[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})/?$" {
        set $sv_upstream http://frontend:80;
        set $sv_uri      $request_uri;
        if ($sv_is_social_crawler) {
            set $sv_upstream http://backend:8000;
            set $sv_uri      /_preview/watch/$sv_video_id;
        }
        proxy_pass $sv_upstream$sv_uri;

        add_header Vary "User-Agent" always;
        add_header Content-Security-Policy $sv_csp always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy $sv_permissions always;
    }

    location ~ "^/c/(?<sv_username>[A-Za-z0-9_.-]{1,150})/?$" {
        set $sv_upstream http://frontend:80;
        set $sv_uri      $request_uri;
        if ($sv_is_social_crawler) {
            set $sv_upstream http://backend:8000;
            set $sv_uri      /_preview/c/$sv_username;
        }
        proxy_pass $sv_upstream$sv_uri;

        add_header Vary "User-Agent" always;
        add_header Content-Security-Policy $sv_csp always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy $sv_permissions always;
    }

    # The site root gets the same split as /watch/: index.html can only carry a
    # relative og:image, and several unfurlers refuse to resolve one.
    location = / {
        set $sv_upstream http://frontend:80;
        set $sv_uri      /;
        if ($sv_is_social_crawler) {
            set $sv_upstream http://backend:8000;
            set $sv_uri      /_preview/site;
        }
        proxy_pass $sv_upstream$sv_uri;

        add_header Vary "User-Agent" always;
        add_header Content-Security-Policy $sv_csp always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy $sv_permissions always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
    }

    # ---- React SPA -------------------------------------------------------
    location / {
        set $spa http://frontend:80;
        proxy_pass $spa$request_uri;

        add_header Content-Security-Policy $sv_csp always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy $sv_permissions always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
    }
}
