# StreamVerse — copy to `.env` and adjust. `docker compose up --build` reads it.
# Every value below has a working default except DJANGO_SECRET_KEY.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DEBUG=0
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-please-generate-a-real-secret-key
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:8110
CSRF_TRUSTED_ORIGINS=http://localhost:8110

# Public identity. SITE_URL must be the origin users actually type: it is what
# sitemap.xml, robots.txt and every Open Graph tag emit as an absolute URL.
SITE_URL=http://localhost:8110
SITE_NAME=StreamVerse
SITE_DESCRIPTION=Partagez, decouvrez et diffusez des videos en direct sur StreamVerse.

# TLS hardening. All off by default because the demo runs on plain HTTP.
# SECURE_HSTS_SECONDS is effectively irreversible for its duration once a
# browser has seen it — set it only when TLS is permanent (31536000 = 1 year).
SECURE_HSTS_SECONDS=0
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
FRONTEND_URL=http://localhost:8110
LOG_LEVEL=INFO
TIME_ZONE=UTC

# JWT lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ---------------------------------------------------------------------------
# Google sign-in (optional)
#
# Leave both blank to turn the feature off: /api/auth/providers/ then reports
# Google as disabled and the frontend does not render the button.
#
# To turn it on, in console.cloud.google.com > APIs & Services > Credentials,
# create an "OAuth client ID" of type "Web application" and set:
#   Authorized JavaScript origins:  http://localhost:8110
#   Authorized redirect URIs:       http://localhost:8110/auth/google/callback
# Google matches the redirect URI as an exact string — a trailing slash or a
# different port is a rejected sign-in, not a warning.
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Defaults to FRONTEND_URL + /auth/google/callback; set it only if the SPA is
# served from somewhere else.
GOOGLE_OAUTH_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Host ports (non-default so several projects can share one server)
# ---------------------------------------------------------------------------
APP_HOST_PORT=8110
POSTGRES_HOST_PORT=5459
REDIS_HOST_PORT=6402
FLOWER_HOST_PORT=5574
MINIO_API_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
# RTMP ingest (MediaMTX). Non-default so it can share a host with other stacks.
RTMP_HOST_PORT=1936

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_DB=streamverse
POSTGRES_USER=streamverse
POSTGRES_PASSWORD=streamverse

# ---------------------------------------------------------------------------
# MinIO object storage
#
# MINIO_PUBLIC_ENDPOINT is what the BROWSER uses. Presigned URLs are signed
# against this host, so if you expose the stack on a domain rather than
# localhost, change it here or private playback will fail signature validation.
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=streamverse
MINIO_ROOT_PASSWORD=streamverse-secret
MINIO_PUBLIC_ENDPOINT=http://localhost:9010
MINIO_PUBLIC_BUCKET=streamverse-public
MINIO_PRIVATE_BUCKET=streamverse-private
# Lifetime of presigned segment URLs / a private playback session (seconds).
MINIO_PRESIGN_TTL_SECONDS=21600

# ---------------------------------------------------------------------------
# Transcoding
# ---------------------------------------------------------------------------
# Match to real CPU cores. Each slot can saturate a core for the length of an
# encode — see README "Performance & scaling".
CELERY_WORKER_CONCURRENCY=2
# veryfast is the speed/quality compromise for CPU encoding. `medium` or `slow`
# give better quality per bit at multiples of the wall-clock cost.
FFMPEG_PRESET=veryfast
# Set to h264_nvenc (and use an NVIDIA-runtime host) for hardware encoding.
FFMPEG_VIDEO_ENCODER=libx264
HLS_SEGMENT_SECONDS=4

MAX_UPLOAD_BYTES=5368709120
MAX_VIDEO_DURATION_SECONDS=14400
UPLOAD_SESSION_TTL_HOURS=24

# Profile images (avatar + channel banner). Both land in the public bucket and
# are re-checked server-side by decoding the file, so these are the real limits
# and not a hint to the browser.
MAX_AVATAR_BYTES=5242880
MAX_BANNER_BYTES=10485760
MAX_AVATAR_DIMENSION=2048
MAX_BANNER_DIMENSION=6000

# ---------------------------------------------------------------------------
# Engagement & search
# ---------------------------------------------------------------------------
# A view only counts after this much watch time — or 30% of the video, whichever
# is smaller, so short clips stay countable. Enforced server-side; the client
# cannot talk a counter up.
VIEW_MIN_SECONDS=30
# Repeat views from the same identity inside this window collapse into one row,
# so reloading a page does not inflate the count.
VIEW_DEDUP_WINDOW_SECONDS=43200
# PostgreSQL text-search dictionary. 'french' stems French; use 'simple' for a
# mixed-language catalogue where stemming does more harm than good.
SEARCH_LANGUAGE_CONFIG=french

# ---------------------------------------------------------------------------
# Live streaming (MediaMTX)
#
# The stream key travels in the OBS "Stream Key" field as `<slug>?key=<secret>`,
# so the RTMP *path* stays public and the HLS URL viewers fetch never contains
# the secret.
# ---------------------------------------------------------------------------
LIVE_RTMP_APP=live
# What broadcasters type into OBS's Server field. Change the host if you expose
# the stack on a domain rather than localhost.
LIVE_RTMP_PUBLIC_URL=rtmp://localhost:1936
# Same-origin path where nginx proxies MediaMTX's HLS output.
LIVE_HLS_PUBLIC_PATH=/live-hls
# Shared secret for the MediaMTX ready/notReady hooks. CHANGE THIS.
LIVE_HOOK_SECRET=change-me-live-hook-secret
# Where MediaMTX writes recordings. Shared volume between the mediamtx and
# celery-worker containers; must match the mount path in docker-compose.yml.
LIVE_RECORDINGS_DIR=/data/recordings
# Seconds to wait after a stream ends before reading its recording — MediaMTX
# is still flushing when the hook fires.
LIVE_RECORDING_SETTLE_SECONDS=20
# Raw recordings are deleted this many days after being converted to VOD.
LIVE_RECORDING_RETENTION_DAYS=7
# Minimum gap between two chat messages from one socket.
LIVE_CHAT_MIN_INTERVAL_SECONDS=1.0

# --- Going live from a browser (WebRTC) ---
# The host a BROWSER can reach MediaMTX on for WebRTC media. Container IPs are
# useless off-host, so change this to the public hostname or IP for any
# deployment that is not localhost, or ICE will never connect.
LIVE_WEBRTC_HOST=localhost
# UDP port where WebRTC media arrives. Unlike HLS and the WHIP handshake, this
# cannot be proxied by nginx.
WEBRTC_UDP_HOST_PORT=8189
# How long a browser publish ticket stays valid.
LIVE_WHIP_TICKET_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Monetization
#
# PAYMENTS_USE_MOCK is the single switch between the simulator and real
# providers. While it is on, the checkout UI shows a sandbox banner — a payment
# simulator that looks identical to a real one is how demo money becomes a
# support ticket. Turning it off with no real provider implemented raises at
# startup rather than silently pretending to take money.
# ---------------------------------------------------------------------------
PAYMENTS_USE_MOCK=1
# HMAC secret the mock signs callbacks with and the webhook verifier checks.
MOCK_PAYMENT_WEBHOOK_SECRET=change-me-mock-webhook-secret
# How long the simulated payer takes to confirm on their handset.
MOCK_PAYMENT_CONFIRM_DELAY_SECONDS=8
# Share of simulated payments that fail, so the failure path is exercised.
MOCK_PAYMENT_FAILURE_PERCENT=15
# A pending payment nobody confirmed is failed after this many minutes.
PAYMENT_PENDING_TIMEOUT_MINUTES=30
RENEWAL_LEAD_HOURS=24

# Ads: first-party rotation only. No VAST, no exchange, no auction.
ADS_ENABLED=1
# Videos shorter than this get no mid-roll.
ADS_MIN_DURATION_FOR_MIDROLL=120

# ---------------------------------------------------------------------------
# Rate limits (DRF scoped throttles)
# ---------------------------------------------------------------------------
THROTTLE_UPLOAD=20/hour
THROTTLE_AUTH=30/hour
THROTTLE_COMMENT=60/hour
THROTTLE_LIVE_START=10/hour
THROTTLE_CHECKOUT=20/hour

# ---------------------------------------------------------------------------
# Outbound email — activation links and password resets
#
# There is no local mail catcher any more: these two messages are the only mail
# the platform sends and both are useless undelivered, so the configuration is
# real in every environment.
#
# GMAIL: EMAIL_HOST_PASSWORD is NOT the account password. Google has refused
# those over SMTP since May 2022 and answers with a bare `535`. Turn on 2-Step
# Verification, then create an App Password at
# myaccount.google.com > Security > App passwords, and paste its 16 characters
# here (spaces optional). EMAIL_HOST_USER must be the full address, and it is
# also what DEFAULT_FROM_EMAIL falls back to — Gmail rewrites or rejects a From
# that is not the authenticated mailbox.
#
# Other providers: port 587 is STARTTLS (EMAIL_USE_TLS=1, EMAIL_USE_SSL=0),
# port 465 is implicit TLS (the other way round). Never both.
#
# No account yet? Set EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# and the messages, activation links included, are printed to the backend log.
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=15
# Send through the Celery worker instead of inside the request. Set to 0 to send
# inline while debugging a new SMTP setup — errors then surface in the API
# response rather than in the worker log.
EMAIL_ASYNC=1
# Blank falls back to EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
FLOWER_USER=admin
FLOWER_PASSWORD=admin
# Set to 0 to skip demo seeding on boot.
SEED_ON_START=1
UVICORN_WORKERS=2

# Frontend build-time config (baked into the bundle).
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=/ws
